@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="message-panel message-panel--danger">
    <h1 class="page-title text-danger">Something went wrong</h1>
    <p class="mb-2">An error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p class="mb-0">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>

<div class="ticket-card card">
    <div class="card-body">
        <h2 class="h6 text-uppercase text-muted mb-2">Development</h2>
        <p class="mb-2">
            In the <strong>Development</strong> environment, the app can show detailed exception information.
        </p>
        <p class="mb-0 small text-muted">
            Do not enable Development in production. Set <code>ASPNETCORE_ENVIRONMENT</code> to <strong>Development</strong> only for local debugging.
        </p>
    </div>
</div>
