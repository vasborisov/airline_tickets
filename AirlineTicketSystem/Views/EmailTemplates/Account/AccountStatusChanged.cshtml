@{
    ViewData["Title"] = Model.IsActive ? "Акаунтът е активиран" : "Акаунтът е деактивиран";
    Layout = "~/Views/EmailTemplates/Shared/_EmailLayout.cshtml";
}

@model dynamic

@if (Model.IsActive)
{
    <h2>✅ Акаунтът ви е активиран</h2>
    
    <p>Здравейте <strong>@Model.DisplayName</strong>,</p>
    
    <p>Имаме удоволствието да ви уведомим, че вашият акаунт в Airline Ticket System е успешно <strong>активиран</strong>!</p>
    
    <div class="highlight-box">
        <p><strong>🎉 Статус на акаунта: АКТИВЕН</strong></p>
        <p>📧 Имейл: @Model.Email</p>
        <p>📅 Активиран на: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>
    </div>
    
    <p><strong>Отново можете да:</strong></p>
    <ul>
        <li>🔐 Влизате в системата</li>
        <li>✈️ Търсите и резервирате полети</li>
        <li>📋 Управлявате вашите резервации</li>
        <li>⚙️ Използвате всички функции на системата</li>
    </ul>
    
    <a href="@Model.LoginUrl" class="button">Влезте в системата</a>
    
    <p>Ако не сте заявявали активирането на акаунта си или имате въпроси, моля свържете се с нас незабавно.</p>
}
else
{
    <h2>⚠️ Акаунтът ви е деактивиран</h2>
    
    <p>Здравейте <strong>@Model.DisplayName</strong>,</p>
    
    <p>Уведомяваме ви, че вашият акаунт в Airline Ticket System е <strong>деактивиран</strong>.</p>
    
    <div class="highlight-box">
        <p><strong>❌ Статус на акаунта: НЕАКТИВЕН</strong></p>
        <p>📧 Имейл: @Model.Email</p>
        <p>📅 Деактивиран на: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>
    </div>
    
    <p><strong>Това означава, че:</strong></p>
    <ul>
        <li>🚫 Не можете да влизате в системата</li>
        <li>⏸️ Достъпът до всички функции е спрян</li>
        <li>📋 Съществуващите ви резервации остават валидни</li>
        <li>📧 Ще продължите да получавате важни уведомления</li>
    </ul>
    
    <p><strong>Причини за деактивиране:</strong></p>
    <ul>
        <li>Административно решение</li>
        <li>Нарушение на правилата за ползване</li>
        <li>Искане от вашия предприемател (за операторски акаунти)</li>
        <li>Временна мярка за сигурност</li>
    </ul>
}

<p><strong>За повече информация:</strong></p>
<p>Ако имате въпроси относно статуса на вашия акаунт или искате да поискате преразглеждане, моля свържете се с нашия екип за поддръжка.</p>

<p>С уважение,<br>
<strong>Администрацията на Airline Ticket System</strong></p>