@model Airline_Ticket_System.Models.Flight.FlightViewModel

@{
    ViewData["Title"] = "Flight details";
}

<h1 class="page-title">Flight details</h1>
<p class="page-lead mb-3">Route, pricing, capacity, and passenger list.</p>

<div class="card ticket-card mb-4">
    <div class="card-header">Itinerary</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Flight</dt>
            <dd class="col-sm-9">@Model.FlightNumber</dd>

            <dt class="col-sm-3">Departure city</dt>
            <dd class="col-sm-9">@Model.DepartureCity</dd>

            <dt class="col-sm-3">Arrival city</dt>
            <dd class="col-sm-9">@Model.ArrivalCity</dd>

            <dt class="col-sm-3">Departure (UTC)</dt>
            <dd class="col-sm-9">@Model.DepartureDateTime.ToString("g")</dd>

            <dt class="col-sm-3">Gate</dt>
            <dd class="col-sm-9">@(Model.Gate ?? "—")</dd>

            <dt class="col-sm-3">Duration</dt>
            <dd class="col-sm-9">@Model.Duration minutes</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">@Model.Price.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("fr-FR"))</dd>

            <dt class="col-sm-3">Capacity</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge badge-secondary">@Model.Status</span>
                @if (Model.IsFullyBooked)
                {
                    <span class="badge badge-danger">Fully booked</span>
                }
                else if (Model.Status != "Cancelled")
                {
                    <span class="badge badge-success">Seats available</span>
                }
            </dd>
        </dl>
    </div>
</div>

<h2 class="h5 font-weight-bold text-dark mb-3">Booked passengers</h2>

@if (Model.PassengerViewModels != null && Model.PassengerViewModels.Any())
{
    <div class="table-responsive">
        <table class="table table-ats table-bordered mb-0">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var passenger in Model.PassengerViewModels)
                {
                    <tr>
                        <td>@passenger.PrintAllName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info mb-0" role="status">No passengers booked for this flight yet.</div>
}

<p class="mt-4 mb-0">
    <a class="btn btn-outline-secondary" asp-controller="Flight" asp-action="Index">Back to flights</a>
</p>
