@using Airline_Ticket_System.Data.Entities
@using Airline_Ticket_System.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Users";
    var isAdmin = User.IsInRole("Admin");
}

@if (isAdmin)
{
    <h1 class="page-title">Users</h1>
    <p class="page-lead mb-3">Accounts and roles. Operators can be added from here.</p>

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
    }

    <div class="filter-bar d-flex flex-column flex-md-row justify-content-md-between align-items-md-center">
        <span class="text-muted small mb-2 mb-md-0">Manage staff and review assignments. Toggle user status to enable/disable accounts.</span>
        <a class="btn btn-success" asp-area="" asp-controller="Account" asp-action="RegisterOperator">New operator</a>
    </div>

    <div class="table-responsive">
        <table class="table table-ats table-bordered table-striped mb-0">
            <thead>
                <tr>
                    <th scope="col">User</th>
                    <th scope="col">Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var roles = await UserManager.GetRolesAsync(user);
                    var roleNames = string.Join(", ", roles);

                    <tr>
                        <td>@($"{user.FirstName} {user.FamilyName}")</td>
                        <td>@user.Email</td>
                        <td>@roleNames</td>
                        <td>
                            <span class="badge @(user.IsActive ? "badge-success" : "badge-danger")">
                                @(user.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success")"
                                        onclick="return confirm('@(user.IsActive ? "Disable" : "Enable") this user?');">
                                    @(user.IsActive ? "Disable" : "Enable")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
