@{
    ViewData["Title"] = "Home";
}

<div class="page-hero text-center home-cta">
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <h1 class="page-title">Welcome back</h1>
        <p class="page-lead mb-4">Browse routes and book your next trip.</p>
        <a class="btn btn-primary" asp-controller="Flight" asp-action="Index">View flights</a>
    }
    else
    {
        <h1 class="page-title">Airline Ticket System</h1>
        <p class="page-lead mb-4">Sign in or register to search flights and manage bookings.</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Log in</a>
        <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Register">Register</a>
    }
</div>
