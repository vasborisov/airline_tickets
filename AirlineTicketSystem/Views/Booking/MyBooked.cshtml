@model IEnumerable<Airline_Ticket_System.Entities.FlightPassenger>

<h1 class="page-title">My booked flights</h1>
<p class="page-lead mb-3">Your reservations and cancellation options.</p>

@if (TempData["BookingMessage"] != null)
{
    <div class="alert alert-success" role="status">@TempData["BookingMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info" role="status">You have not booked any flights.</div>
}
else
{
    <div class="table-responsive">
    <table class="table table-ats table-bordered table-striped mb-0">
        <thead>
            <tr>
                <th>PNR</th>
                <th>From → To</th>
                <th>Passenger</th>
                <th>Booked</th>
                <th>Status</th>
                <th>Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td><a asp-action="ByPnr" asp-route-pnr="@booking.Pnr">@booking.Pnr</a></td>
                    <td>@booking.Flight?.DepartureCity → @booking.Flight?.ArrivalCity</td>
                    <td>@($"{booking.Passenger?.FirstName} {booking.Passenger?.FamilyName}")</td>
                    <td>@booking.CreatedAt.ToString("g")</td>
                    <td>@booking.BookingStatus</td>
                    <td>@(booking.PaymentAmount?.ToString("C") ?? booking.Flight?.Price.ToString("C"))</td>
                    <td>
                        @if (booking.BookingStatus == "Confirmed")
                        {
                            <form asp-action="Cancel" method="post" class="d-inline" onsubmit="return confirm('Cancel this booking?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@booking.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
