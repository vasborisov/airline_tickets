        function clearPassengerFields() {
            const firstNameField = document.getElementById("FirstName");
            const familyNameField = document.getElementById("FamilyName");
            const emailField = document.getElementById("Email");
            
            if (firstNameField && !firstNameField.readOnly) firstNameField.value = "";
            if (familyNameField && !familyNameField.readOnly) familyNameField.value = "";
            if (emailField && !emailField.readOnly) emailField.value = "";
        }
        
        function clearPassengerSelection() {
            const select = document.getElementById("SelectedPassengerId");
            if (select) {
                select.selectedIndex = 0; // Reset to first option (empty option)
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            handleBookingMode(); 
            togglePassengerFields();
