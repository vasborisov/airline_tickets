@model Airline_Ticket_System.Models.Booking.BookSeatViewModel
@{
    var isUser = User.IsInRole("User");
}

<h1 class="page-title">Book a seat</h1>
<p class="page-lead mb-3">Confirm flight details and passenger information.</p>

<div class="card ticket-card mb-3">
    <div class="card-header">Itinerary</div>
    <div class="card-body">
        <h2 class="h5 card-title mb-3">@Model.DepartureCity → @Model.ArrivalCity</h2>
        <p><strong>Duration:</strong> @Model.Duration minutes</p>
        <p><strong>Price:</strong> @Model.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))</p>
    </div>
</div>

<form asp-action="Create" method="post">
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
    <input type="hidden" asp-for="FlightId" />
    <input type="hidden" asp-for="CreateNewPassenger" />

    @if (isUser)
    {
        <!-- For User role: Show "Book for myself" checkbox and "Create new passenger" option -->
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" asp-for="IsBookingForSelf" id="isBookingForSelf" onchange="handleBookingMode()" checked="@Model.IsBookingForSelf" />
            <label class="form-check-label" for="isBookingForSelf">Book for myself</label>
        </div>

        <div class="form-group" id="passenger-selection-options">
            <label class="font-weight-bold">Passenger Selection:</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="passengerOption" id="createNewPassenger" value="new" onchange="togglePassengerFields()" checked />
                <label class="form-check-label" for="createNewPassenger">Create new passenger</label>
            </div>
        </div>
    }
    else
    {
        <!-- For Admin/Operator role: Show "Select registered user" and "Create new passenger" options -->
        <div class="form-group" id="passenger-selection-options">
            <label class="font-weight-bold">Passenger Selection:</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="passengerOption" id="selectExistingUser" value="existing" onchange="togglePassengerFields()" />
                <label class="form-check-label" for="selectExistingUser">Select registered user</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="passengerOption" id="createNewPassenger" value="new" onchange="togglePassengerFields()" checked />
                <label class="form-check-label" for="createNewPassenger">Create new passenger</label>
            </div>
        </div>
    }

    <div id="existing-passenger-fields" class="form-group" style="display:none;">
        <label>Select Registered User</label>
        <select asp-for="SelectedPassengerId" class="form-control" asp-items="Model.ExistingPassengers">
            <option value="">-- Select User --</option>
        </select>
    </div>

    <div id="new-passenger-fields" style="display:none;">
        <div class="form-group">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" class="form-control" 
                   data-user-firstname="@(isUser ? Model.FirstName ?? "" : "")"
                   readonly="@(isUser && Model.IsBookingForSelf)" />
